<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBoasVindas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Jogador, pensei em um número!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="36dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seu palpite"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/edtPalpite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite um número"
            android:inputType="number"
            android:gravity="center"
            android:textSize="20sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnChutar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHUTAR"
            android:textSize="17sp"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Faça seu primeiro palpite!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtTentativas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tentativas: 0"
            android:textSize="18sp" />

        <Button
            android:id="@+id/btnJogarNovamente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JOGAR DE NOVO"
            android:textSize="17sp"
            android:visibility="gone"
            android:layout_marginTop="28dp" />

    </LinearLayout>

</ScrollView>
